# MiMi local development — Ollama Cloud (no local Ollama install required)
# Copy to .env and export in your shell, or use direnv.

RUST_LOG=debug

ZENOH_ENDPOINT=tcp/localhost:7449
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mimi-password
REDIS_URL=redis://:mimi-redis-password@localhost:6379

# Ollama Cloud — https://docs.ollama.com/cloud
MIMI_ADAPTER_TYPE=ollama
OLLAMA_API_KEY=
OLLAMA_ENDPOINT=https://ollama.com
OLLAMA_MODEL=gemma4:31b

MIMI_AUTH_SECRET=dev-only-not-for-production
MIMI_AUTH_TOKEN_TTL_SECS=86400
