# MiMi production environment template
# Copy to .env.production and adjust values before deploy.

RUST_LOG=info

ZENOH_ENDPOINT=tcp/zenoh:7449
ZENOH_MODE=client

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-strong-password

REDIS_URL=redis://:change-me-redis-password@redis:6379

MIMI_HTTP_BIND=0.0.0.0:8080
MIMI_WS_BIND=0.0.0.0:8081

MIMI_AUTH_SECRET=change-me-jwt-secret-min-32-chars
MIMI_AUTH_TOKEN_TTL_SECS=3600

# Ollama Cloud (primary LLM backend)
MIMI_ADAPTER_TYPE=ollama
OLLAMA_API_KEY=change-me-ollama-cloud-key
OLLAMA_ENDPOINT=https://ollama.com
OLLAMA_MODEL=gemma4:31b

# Optional fallback
# GEMINI_API_KEY=
